{
	# The distro caddy.service owns 127.0.0.1:2019. Binding a distinct port keeps
	# the two units from fighting over the admin endpoint.
	admin 127.0.0.1:2020

	# Declaring any https:// site makes Caddy open a redirect listener on :80,
	# which Nginx Proxy Manager already owns. The explicit redirect site below
	# covers that need without the port conflict.
	auto_https disable_redirects
}

(cc_auth) {
	basic_auth {
		{$CC_AUTH_USER} {$CC_AUTH_HASH}
	}
}

# Vaultwarden's web vault uses the WebCrypto API, which browsers only expose
# in a secure context. Over plain HTTP on a LAN address it refuses to run and
# tells you to enable HTTPS. Caddy's internal CA issues a certificate for this
# host, which satisfies that requirement once the CA is trusted.
(cc_tls) {
	tls internal
}

:3000 {
	import cc_auth

	handle_path /ollama/* {
		reverse_proxy 127.0.0.1:11434
	}

	handle_path /cockpit/* {
		reverse_proxy https://127.0.0.1:9090 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:7575
	}
}

:4096 {
	import cc_auth

	# Homarr embeds this origin in an iframe widget; the defaults would refuse.
	header {
		-X-Frame-Options
		Content-Security-Policy "frame-ancestors 'self' http://192.168.1.171:3000 http://192.168.1.171:7575"
	}

	reverse_proxy 127.0.0.1:4097 {
		header_up Authorization {http.request.header.Authorization}
	}
}

:3001 {
	import cc_auth

	reverse_proxy 127.0.0.1:3002
}

:9091 {
	import cc_auth

	reverse_proxy https://127.0.0.1:9090 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# Phase A services. Each gets its own port because these are single-page apps
# that break when served from a sub-path.
:8181 {
	import cc_auth
	reverse_proxy 127.0.0.1:8081
}

:8182 {
	import cc_auth
	reverse_proxy 127.0.0.1:8082
}

:8183 {
	import cc_auth

	# qBittorrent validates the Host header against its own listener and
	# answers 401 on a mismatch, and it reads any inbound Authorization header
	# as its own WebUI login. Caddy has already authenticated the caller, so
	# rewrite Host to the upstream and drop the credential.
	reverse_proxy 127.0.0.1:8083 {
		header_up -Authorization
		header_up Host {upstream_hostport}
	}
}

:9118 {
	import cc_auth
	reverse_proxy 127.0.0.1:9117
}

# HTTPS, because the web vault will not run in an insecure context.
https://192.168.1.171:8184 {
	import cc_tls
	import cc_auth
	reverse_proxy 127.0.0.1:8084
}

# Plain HTTP on the same port would collide with the TLS listener, so send
# anyone arriving over HTTP to the secure URL instead of failing opaquely.
http://192.168.1.171:8186 {
	redir https://192.168.1.171:8184{uri} permanent
}

:7682 {
	import cc_auth
	reverse_proxy 127.0.0.1:7681
}

:8185 {
	import cc_auth
	reverse_proxy 127.0.0.1:8085
}

:61209 {
	import cc_auth
	reverse_proxy 127.0.0.1:61208
}

