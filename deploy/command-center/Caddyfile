{
	# The distro caddy.service owns 127.0.0.1:2019. Binding a distinct port keeps
	# the two units from fighting over the admin endpoint.
	admin 127.0.0.1:2020

	# Declaring any https:// site makes Caddy open a redirect listener on :80,
	# which Nginx Proxy Manager already owns. The explicit redirect site below
	# covers that need without the port conflict.
	auto_https disable_redirects
}

# Single sign-on. Basic auth is scoped per origin, and an origin includes the
# port, so one prompt per service was unavoidable with it. tinyauth issues a
# host-scoped cookie instead, which every port on this address shares, so one
# login covers the whole command center.
(cc_auth) {
	# Bounce IP-addressed requests to the hostname first. The session cookie
	# cannot be scoped to an IP literal (see services/sso.yml), so arriving by
	# IP would mean no session and a fresh login every time. redir is ordered
	# ahead of forward_auth, so this settles before the auth check runs, and
	# existing IP bookmarks keep working.
	@ip host 192.168.1.171
	redir @ip http://192.168.1.171.sslip.io:{http.request.local.port}{uri} 302

	forward_auth 127.0.0.1:3011 {
		uri /api/auth/caddy
		copy_headers Remote-User Remote-Name Remote-Email Remote-Groups
	}
}

# OpenCode runs its own basic auth. Under the old scheme the browser sent an
# Authorization header that was simply forwarded; the cookie-based session
# carries none, so forwarding produced an empty header and OpenCode answered
# 401 with no body, which is what rendered as a blank panel. Caddy now
# presents the credential itself.
(cc_opencode_upstream) {
	reverse_proxy 127.0.0.1:4097 {
		header_up Authorization "Basic {$CC_OPENCODE_BASIC}"
	}
}

# Panels are framed by the board, which is now served from the hostname
# rather than the IP. An origin missing from this list is refused by the
# browser and shows an empty box.
(cc_frame_allow) {
	header {
		-X-Frame-Options
		Content-Security-Policy "frame-ancestors 'self' http://192.168.1.171.sslip.io:3000 http://192.168.1.171.sslip.io:7575 http://192.168.1.171:3000 http://192.168.1.171:7575"
	}
}

# Retained for the handful of endpoints that are consumed by scripts rather
# than browsers, where a redirect to a login page would break the caller.
(cc_basic_auth) {
	basic_auth {
		{$CC_AUTH_USER} {$CC_AUTH_HASH}
	}
}

# Vaultwarden's web vault uses the WebCrypto API, which browsers only expose
# in a secure context. Over plain HTTP on a LAN address it refuses to run and
# tells you to enable HTTPS. Caddy's internal CA issues a certificate for this
# host, which satisfies that requirement once the CA is trusted.
(cc_tls) {
	tls internal
}

# The login UI itself must never sit behind the thing it authenticates, or the
# redirect loops forever.
:3010 {
	reverse_proxy 127.0.0.1:3011
}

# OpenID Connect requires the issuer to be served over TLS and refuses to
# start otherwise, so the provider gets a second, secure origin. The
# certificate comes from Caddy's internal CA, whose root has to be trusted by
# each browser and by the Homarr container that fetches discovery.
https://auth.192.168.1.171.sslip.io:3443 {
	import cc_tls
	reverse_proxy 127.0.0.1:3012
}

:3000 {
	import cc_auth

	handle_path /ollama/* {
		reverse_proxy 127.0.0.1:11434
	}

	handle_path /cockpit/* {
		reverse_proxy https://127.0.0.1:9090 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	# The embedded panels are served from their own ports, not from a subpath
	# here. OpenCode calls absolute /api/* routes and this origin's /api/*
	# belongs to Homarr, so a subpath sends every one of its requests to the
	# wrong server and the panel renders blank. The subpath only existed
	# because cross-origin basic auth never carried the credential; the
	# session cookie is scoped to the host and ignores the port, so framing
	# a sibling port now works and keeps each app on its own /api namespace.

	handle {
		reverse_proxy 127.0.0.1:7575
	}
}

:4096 {
	import cc_auth

	# Homarr embeds this origin in an iframe widget; the defaults would refuse.
	import cc_frame_allow

	import cc_opencode_upstream
}

:3001 {
	import cc_auth

	reverse_proxy 127.0.0.1:3002
}

:9091 {
	import cc_auth

	reverse_proxy https://127.0.0.1:9090 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# Phase A services. Each gets its own port because these are single-page apps
# that break when served from a sub-path.
:8181 {
	import cc_auth
	# Pi-hole serves its UI under /admin and answers 403 at the root, so a
	# tile pointing at the bare host looks broken.
	redir / /admin/ 302
	reverse_proxy 127.0.0.1:8081
}

:8182 {
	import cc_auth
	reverse_proxy 127.0.0.1:8082
}

:8183 {
	import cc_auth

	# qBittorrent validates the Host header against its own listener and
	# answers 401 on a mismatch, and it reads any inbound Authorization header
	# as its own WebUI login. Caddy has already authenticated the caller, so
	# rewrite Host to the upstream and drop the credential.
	reverse_proxy 127.0.0.1:8083 {
		header_up -Authorization
		header_up Host {upstream_hostport}
	}
}

:9118 {
	import cc_auth
	reverse_proxy 127.0.0.1:9117
}

# HTTPS, because the web vault will not run in an insecure context.
https://192.168.1.171:8184 {
	import cc_tls
	import cc_auth
	reverse_proxy 127.0.0.1:8084
}

# Plain HTTP on the same port would collide with the TLS listener, so send
# anyone arriving over HTTP to the secure URL instead of failing opaquely.
http://192.168.1.171:8186 {
	redir https://192.168.1.171:8184{uri} permanent
}

:7682 {
	import cc_auth

	# Embedded as a terminal panel on the board, so the same framing allowance
	# the OpenCode panel needs applies here.
	import cc_frame_allow

	# ttyd upgrades to a websocket for the terminal stream.
	reverse_proxy 127.0.0.1:7681
}

:8185 {
	import cc_auth
	reverse_proxy 127.0.0.1:8085
}

:61209 {
	import cc_auth

	# Glances validates the Host header against webui_allowed_hosts and answers
	# 400 on anything else, so present the upstream's own address.
	reverse_proxy 127.0.0.1:61208 {
		header_up Host {upstream_hostport}
	}
}

