#!/usr/bin/env bash
# Command center deployment orchestrator. Installed to /usr/local/sbin/cc-deploy.
#
# All credential lookup and privileged mutation lives here rather than in the
# commands that invoke it, so a deploy step is a single verb with no secrets on
# the command line.
#
#   cc-deploy phase-b     bring up the media and docs stack
#   cc-deploy phase-c     bring up the heavy stack
#   cc-deploy caddy       reload the proxy from the staged Caddyfile
#   cc-deploy status      report health of everything
#   cc-deploy headroom    measure RAM with Ollama loaded
set -euo pipefail

readonly SERVICES_DIR=/opt/command-center/services
readonly CONFIG_DIR=/etc/command-center
readonly AGENT_ENV=/etc/colony-agent/agent.env

[[ "${EUID:-$(id -u)}" -eq 0 ]] || {
  printf 'cc-deploy must run as root\n' >&2
  exit 1
}

log() { printf '%s\n' "$*" >&2; }
die() { log "error: $*"; exit 1; }

load_secrets() {
  [[ -f "$AGENT_ENV" ]] || die "missing $AGENT_ENV"
  # shellcheck disable=SC1090
  source "$AGENT_ENV"
  export CC_SHARED_PASSWORD="${OPENCODE_SERVER_PASSWORD:?}"

  local keyfile="$CONFIG_DIR/bookstack.key"
  if [[ ! -f "$keyfile" ]]; then
    install -d -m 0750 "$CONFIG_DIR"
    printf 'base64:%s\n' "$(openssl rand -base64 32)" >"$keyfile"
    chmod 0640 "$keyfile"
  fi
  export BOOKSTACK_APP_KEY
  BOOKSTACK_APP_KEY="$(cat "$keyfile")"
}

compose() {
  local phase="$1"; shift
  docker compose -f "$SERVICES_DIR/$phase.yml" "$@"
}

# Pulling and extracting images is a memory-intensive burst, not a steady load.
# Gating on MemAvailable or on swap-thrashing rate is not enough: both looked
# healthy at 190MB genuinely free, and the subsequent Phase C pull took the
# whole host offline. Require real free memory before any image pull.
require_free_memory() {
  local need_mb="$1" free_mb avail_mb
  free_mb="$(awk '/^MemFree:/{print int($2/1024)}' /proc/meminfo)"
  avail_mb="$(awk '/MemAvailable:/{print int($2/1024)}' /proc/meminfo)"
  if ((free_mb < need_mb)); then
    die "only ${free_mb}MB free (${avail_mb}MB available); need ${need_mb}MB before pulling images.
Free memory first: stop non-essential containers, or lower Ollama's cap with
  systemctl set-property --runtime ollama.service MemoryMax=3G"
  fi
  log "preflight: ${free_mb}MB free, ${avail_mb}MB available"
}

wait_http() {
  local name="$1" url="$2" tries="${3:-30}" code
  for ((i = 1; i <= tries; i++)); do
    code="$(curl -sSL -o /dev/null -w '%{http_code}' --max-time 6 "$url" 2>/dev/null || echo 000)"
    if [[ "$code" =~ ^(200|301|302|401)$ ]]; then
      printf '  %-16s %s (%ds)\n' "$name" "$code" "$((i * 5))"
      return 0
    fi
    sleep 5
  done
  printf '  %-16s TIMEOUT after %ds\n' "$name" "$((tries * 5))"
  return 1
}

cmd_phase_b() {
  load_secrets
  [[ -f "$SERVICES_DIR/phase-b.yml" ]] || die "phase-b.yml not staged"
  compose phase-b up -d

  # Jellyfin belongs to the pre-existing host stack, which already has hardware
  # transcoding wired up. Start it there instead of duplicating the container.
  docker compose -f /srv/docker/docker-compose.yml up -d jellyfin 2>&1 | tail -3

  log ""
  log "waiting for Phase B services"
  local rc=0
  wait_http radarr    http://127.0.0.1:7878 36 || rc=1
  wait_http sonarr    http://127.0.0.1:8989 36 || rc=1
  wait_http jellyfin  http://127.0.0.1:8096 36 || rc=1
  wait_http bookstack http://127.0.0.1:6875 48 || rc=1
  return $rc
}

cmd_phase_c() {
  load_secrets
  [[ -f "$SERVICES_DIR/phase-c.yml" ]] || die "phase-c.yml not staged"
  local jwt="$CONFIG_DIR/tianji-jwt.key"
  if [[ ! -f "$jwt" ]]; then
    openssl rand -hex 32 >"$jwt"
    chmod 0640 "$jwt"
  fi
  export TIANJI_JWT_SECRET
  TIANJI_JWT_SECRET="$(cat "$jwt")"

  require_free_memory 2048
  compose phase-c up -d
  log ""
  log "waiting for Phase C light tier"
  local rc=0
  wait_http code-server http://127.0.0.1:8443 36 || rc=1
  wait_http tianji      http://127.0.0.1:12345 48 || rc=1
  return $rc
}

cmd_immich() {
  load_secrets
  [[ -f "$SERVICES_DIR/phase-c-immich.yml" ]] || die "phase-c-immich.yml not staged"
  require_free_memory 2560
  compose phase-c-immich up -d
  log ""
  log "waiting for Immich"
  wait_http immich http://127.0.0.1:2283 72
}

# Brings up the single sign-on provider, deriving its credentials from the
# same shared password everything else uses so there is one store, not two.
cmd_sso() {
  load_secrets
  [[ -f "$SERVICES_DIR/sso.yml" ]] || die "sso.yml not staged"

  local secret_file="$CONFIG_DIR/sso-secret"
  # tinyauth rejects anything that is not exactly 32 characters, so regenerate
  # rather than trusting whatever is already on disk.
  if [[ ! -f "$secret_file" || $(tr -d '\n' <"$secret_file" | wc -c) -ne 32 ]]; then
    openssl rand -hex 16 | tr -d '\n' >"$secret_file"
    chmod 0640 "$secret_file"
  fi
  export CC_SSO_SECRET
  CC_SSO_SECRET="$(tr -d '\n' <"$secret_file")"

  local user pass hash
  user="$(grep '^OPENCODE_SERVER_USERNAME=' "$AGENT_ENV" | cut -d= -f2-)"
  pass="$CC_SHARED_PASSWORD"
  # Values in agent.env may be quoted. Hashing the quotes yields a credential
  # nobody can type, and the failure looks identical to a wrong password.
  user="${user%\"}"; user="${user#\"}"
  pass="${pass%\"}"; pass="${pass#\"}"
  hash="$(caddy hash-password --plaintext "$pass")"
  export CC_SSO_USERS="${user}:${hash}"

  compose sso up -d
  sleep 8
  # Probe the container directly; Caddy's 3010 front door may not be reloaded
  # onto this yet.
  wait_http tinyauth http://127.0.0.1:3011/ 24

  # A provider that is up but rejects the shared credential locks every
  # service at once, so prove the login works before leaving it in place.
  local code
  code="$(curl -s -o /dev/null -w '%{http_code}' -X POST \
    -H 'Content-Type: application/json' \
    --data-binary @<(printf '{"username":%s,"password":%s}' \
      "$(printf '%s' "$user" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')" \
      "$(printf '%s' "$pass" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')") \
    http://127.0.0.1:3011/api/login)"
  if [[ "$code" != "200" ]]; then
    die "sso rejected the shared credential (HTTP $code); not switching auth over"
  fi
  printf '  sso login verified\n'
}

# OpenCode enforces its own basic auth. The cookie session carries no
# Authorization header, so Caddy has to present the credential on its behalf
# or OpenCode answers 401 with an empty body and the panel renders blank.
cmd_opencode_auth() {
  load_secrets
  local user pass env_file=/etc/command-center/caddy.env
  user="$(grep '^OPENCODE_SERVER_USERNAME=' "$AGENT_ENV" | cut -d= -f2-)"
  pass="$CC_SHARED_PASSWORD"
  user="${user%\"}"; user="${user#\"}"
  pass="${pass%\"}"; pass="${pass#\"}"

  local encoded
  encoded="$(printf '%s:%s' "$user" "$pass" | base64 | tr -d '\n')"
  touch "$env_file"; chmod 0640 "$env_file"
  grep -v '^CC_OPENCODE_BASIC=' "$env_file" >"$env_file.tmp" 2>/dev/null || true
  printf 'CC_OPENCODE_BASIC=%s\n' "$encoded" >>"$env_file.tmp"
  mv "$env_file.tmp" "$env_file"
  chmod 0640 "$env_file"
  printf '  opencode credential written to %s\n' "$env_file"
}

# Brings up tinyauth v5 next to v3 and proves it before anything points at
# it. A provider that is up but rejects the credential locks out every
# service at once, so this never touches Caddy.
cmd_sso_v5() {
  load_secrets
  local dir="$CONFIG_DIR/oidc"
  install -d -m 0750 "$dir"

  local secret_file="$dir/homarr-client-secret" users_file="$dir/users"
  [[ -f "$secret_file" ]] || openssl rand -hex 32 | tr -d '\n' >"$secret_file"

  local user pass
  user="$(grep '^OPENCODE_SERVER_USERNAME=' "$AGENT_ENV" | cut -d= -f2-)"
  pass="$CC_SHARED_PASSWORD"
  user="${user%\"}"; user="${user#\"}"
  pass="${pass%\"}"; pass="${pass#\"}"
  printf '%s:%s\n' "$user" "$(caddy hash-password --plaintext "$pass")" \
    >"$users_file"
  # The container runs unprivileged and reads these, so they are not 0600.
  chmod 0644 "$secret_file" "$users_file"

  compose sso-v5 up -d
  sleep 10
  wait_http tinyauth-v5 http://127.0.0.1:3012/ 24

  # Discovery is what Homarr fetches first; without it the OIDC login never
  # starts.
  local disco
  disco="$(curl -s --max-time 10 \
    http://127.0.0.1:3012/.well-known/openid-configuration || true)"
  grep -q authorization_endpoint <<<"$disco" \
    || die "v5 is up but serves no OIDC discovery document"
  printf '  oidc discovery ok\n'

  local code
  code="$(curl -s -o /dev/null -w '%{http_code}' -X POST \
    -H 'Content-Type: application/json' \
    --data-binary @<(printf '{"username":%s,"password":%s}' \
      "$(printf '%s' "$user" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')" \
      "$(printf '%s' "$pass" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')") \
    http://127.0.0.1:3012/api/login)"
  [[ "$code" == "200" ]] || die "v5 rejected the shared credential (HTTP $code)"
  printf '  sso v5 login verified\n'
}

cmd_caddy() {
  [[ -f /tmp/Caddyfile ]] && install -m 0640 /tmp/Caddyfile "$CONFIG_DIR/Caddyfile"
  caddy validate --config "$CONFIG_DIR/Caddyfile" --adapter caddyfile >/dev/null ||
    die "Caddyfile invalid; proxy left untouched"
  systemctl reload command-center-caddy.service ||
    systemctl restart command-center-caddy.service
  sleep 3
  systemctl is-active --quiet command-center-caddy.service ||
    die "caddy failed to come back"
  log "caddy reloaded"
}

cmd_headroom() {
  log "priming Ollama so the measurement reflects a loaded model"
  curl -sS --max-time 180 http://127.0.0.1:11434/api/generate \
    -d '{"model":"qwen3.5:4b","prompt":"hi","stream":false,"keep_alive":"5m"}' \
    >/dev/null 2>&1 || log "warning: could not prime Ollama"
  sleep 5
  local avail swap ollama_mb si so
  avail="$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)"
  swap="$(free -m | awk '/^Swap:/{print $3}')"
  ollama_mb="$(( $(systemctl show ollama.service -p MemoryCurrent --value) / 1048576 ))"

  # Swap occupancy on its own says nothing: Linux parks cold pages there even
  # when memory is plentiful. What matters is whether pages are actively moving,
  # so sample the swap-in/out rate rather than the total.
  read -r si so <<<"$(vmstat 2 3 | tail -1 | awk '{print $7, $8}')"

  printf 'MemAvailable=%sMB SwapUsed=%sMB SwapInRate=%skB/s SwapOutRate=%skB/s OllamaResident=%sMB\n' \
    "$avail" "$swap" "$si" "$so" "$ollama_mb"

  if ((avail < 2048)); then
    printf 'VERDICT=blocked reason=insufficient_available_memory\n'
  elif ((si > 1000 || so > 1000)); then
    printf 'VERDICT=blocked reason=active_swap_thrashing\n'
  else
    printf 'VERDICT=proceed\n'
  fi
}

# Every Caddy listener needs to be reachable from two places: the LAN, where
# the browser lives, and the Docker bridge, where Uptime Kuma probes from.
# Without the bridge rule every monitor reports ETIMEDOUT even though the
# service is healthy.
readonly CC_PORTS=(3000 3001 3010 4096 9091 8181 8182 8183 8184 8185 8186 9118 7682 61209 7879 8990 8097 6876)

# Glances runs with host networking, so it has no docker-proxy rule to bypass
# UFW the way published containers do. Without an explicit allow, Homarr's
# container cannot reach it and the health integration fails to connect even
# though Glances itself is serving fine.
readonly CC_HOST_NETWORK_PORTS=(61208)

cmd_firewall() {
  command -v ufw >/dev/null 2>&1 || { log "ufw not installed; nothing to do"; return 0; }
  ufw status | head -1 | grep -q active || { log "ufw inactive; nothing to do"; return 0; }

  local port
  for port in "${CC_PORTS[@]}"; do
    ufw allow from 192.168.1.0/24 to any port "$port" proto tcp \
      comment 'command-center LAN' >/dev/null
    ufw allow from 172.16.0.0/12 to any port "$port" proto tcp \
      comment 'command-center docker bridge' >/dev/null
  done
  # Homarr does not sit on the default bridge, so cover the wider Docker
  # range rather than 172.17.0.0/16 alone.
  for port in "${CC_HOST_NETWORK_PORTS[@]}"; do
    ufw allow from 172.16.0.0/12 to any port "$port" proto tcp \
      comment 'command-center host-network service' >/dev/null
  done

  # DNS for the whole LAN, which is what makes Pi-hole block ads on phones and
  # laptops rather than only on this host. Restricted to the local subnet so
  # this never becomes an open resolver.
  local proto
  for proto in tcp udp; do
    ufw allow from 192.168.1.0/24 to any port 53 proto "$proto" \
      comment 'pihole LAN DNS' >/dev/null
  done
  log "allowed ${#CC_PORTS[@]} proxy ports and ${#CC_HOST_NETWORK_PORTS[@]} host-network ports"

  # Reloading ufw rewrites the filter table and has previously wiped Docker's
  # published-port rules, which is what silently killed Nginx Proxy Manager.
  # Detect any container that lost its forwarding and put it back.
  local name published
  for name in $(docker ps --format '{{.Names}}'); do
    published="$(docker port "$name" 2>/dev/null | head -1)"
    if [[ -z "$published" ]] &&
      [[ "$(docker inspect "$name" --format '{{len .HostConfig.PortBindings}}')" != "0" ]]; then
      log "restoring lost port forwarding: $name"
      docker restart "$name" >/dev/null
    fi
  done
  log "firewall applied; docker forwarding verified"
}

cmd_status() {
  printf '=== containers ===\n'
  docker ps --format '{{.Names}}\t{{.Status}}' | sort
  printf '\n=== endpoints ===\n'
  local svc
  for svc in \
    "glances|61208" "pihole|8081/admin" "pihole-backup|8082/admin" \
    "qbittorrent|8083" "jackett|9117/UI/Dashboard" "vaultwarden|8084" \
    "ttyd|7681" "stirling|8085" "radarr|7878" "sonarr|8989" \
    "jellyfin|8096" "bookstack|6875" "homarr|7575" "kuma|3002"; do
    local n="${svc%%|*}" hp="${svc#*|}" code jar
    jar="$(mktemp)"
    code="$(curl -sSL -c "$jar" -b "$jar" -o /dev/null -w '%{http_code}' \
      --max-time 8 "http://127.0.0.1:$hp" 2>/dev/null || echo ERR)"
    rm -f "$jar"
    printf '  %-16s %s\n' "$n" "$code"
  done
  printf '\n=== memory ===\n'
  free -m | head -2
}

case "${1:-}" in
  phase-b)  cmd_phase_b ;;
  phase-c)  cmd_phase_c ;;
  immich)   cmd_immich ;;
  sso)      cmd_sso ;;
  sso-v5)   cmd_sso_v5 ;;
  opencode-auth) cmd_opencode_auth ;;
  caddy)    cmd_caddy ;;
  firewall) cmd_firewall ;;
  headroom) cmd_headroom ;;
  status)   cmd_status ;;
  *)
    printf 'usage: cc-deploy {phase-b|phase-c|immich|sso|caddy|firewall|headroom|status}\n' >&2
    exit 64
    ;;
esac
