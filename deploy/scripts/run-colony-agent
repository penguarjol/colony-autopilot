#!/usr/bin/env bash
set -euo pipefail

: "${OPENCODE_SERVER_PASSWORD:?OPENCODE_SERVER_PASSWORD is required}"
COLONY_AGENT_BACKEND_HOST="${COLONY_AGENT_BACKEND_HOST:-127.0.0.1}"
COLONY_AGENT_BACKEND_PORT="${COLONY_AGENT_BACKEND_PORT:-4097}"

export HOME="/var/lib/colony-agent"
export XDG_CACHE_HOME="$HOME/cache"
export XDG_CONFIG_HOME="$HOME/config"
export XDG_DATA_HOME="$HOME/data"
export OPENCODE_CONFIG="/etc/colony-agent/opencode.json"

# Lets the agent query and control the dashboard through Homarr's MCP server.
# Written by the board configuration step; absent on a fresh install, in which
# case the MCP server simply fails to authenticate and the agent still runs.
if [[ -r /etc/colony-agent/homarr-api.key ]]; then
  HOMARR_API_KEY="$(cat /etc/colony-agent/homarr-api.key)"
  export HOMARR_API_KEY
fi

exec /opt/colony-agent/bin/opencode serve \
  --hostname "$COLONY_AGENT_BACKEND_HOST" \
  --port "$COLONY_AGENT_BACKEND_PORT"
