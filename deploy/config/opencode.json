{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.5:4b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.5:4b": {
          "name": "Qwen 3.5 4B",
          "tools": true,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "bash": {
      "*": "allow",
      "docker *": "deny",
      "systemctl *": "deny",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "sudo /usr/local/sbin/colony-agent-status": "allow",
      "sudo /usr/local/sbin/colony-agent-deploy": "allow",
      "sudo /usr/local/sbin/colony-agent-rollback": "allow"
    }
  }
}
